        <mxCell id="e_api_v8_label" value="HTTPS JSON:API&#10;OAuth2 Bearer" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#fff;" vertex="1" connectable="0" parent="e_api_v8">
