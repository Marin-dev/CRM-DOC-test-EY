          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_anon_label" value="HTTP form / tracker (auth=false)" style="edgeLabel;html=1;align=center;verticalAlign=middle;background=#fff;" vertex="1" connectable="0" parent="e_anon_ep">
